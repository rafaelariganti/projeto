<%
/**
 * Layout das telas internas: menu lateral + conteúdo + modais globais.
 * Recebe: titulo, pagina, content, scripts, tela
 */
const user = Auth.out();
const appData = {
  base: base_path(), csrf: Csrf.token(), versao: APP_VERSION,
  pagina, tela: locals.tela ?? null, user,
};
-%><!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= titulo %> — OAF Controle Financeiro</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<link rel="icon" type="image/png" href="<%= url('assets/img/logo-oaf-mark.png') %>"/>
<link rel="stylesheet" href="<%= asset('css/app.css') %>"/>
<script>
  // Evita "piscar" o menu: aplica o estado salvo antes de desenhar a página.
  try { if (localStorage.getItem('dre.menu') === 'fechado') document.documentElement.classList.add('menu-fechado'); } catch (e) {}
  window.APP = <%- json(appData) %>;
</script>
</head>
<body class="pg-<%= pagina %>">
<div class="app">
  <%- partial('partials/sidebar', { 'pagina': pagina, 'user': user }) %>
  <main class="main" id="main">
    <%- content %>
  </main>
</div>
<%- partial('partials/modais-globais', { 'user': user }) %>
<script src="<%= asset('js/core.js') %>"></script>
<% for (const s of scripts) { %>
<script src="<%= asset('js/' + s) %>"></script>
<% } %>
</body>
</html>
