<%# Cabeçalho comum das páginas de LGPD. Recebe: doc, titulo, logado (controlador e contato vêm do PageController) -%>
<div class="lgpd">
  <header class="lgpd-top">
    <a class="lgpd-marca" href="<%= url(logado ? '' : 'login') %>"><img src="<%= url('assets/img/logo-oaf-mark-clara.png') %>" alt=""/><span><b>OAF</b> Controle Financeiro</span></a>
    <nav><a href="<%= url('termos') %>" class="<%- doc === 'termos' ? 'on' : '' %>">Termo de uso</a><a href="<%= url('privacidade') %>" class="<%- doc === 'privacidade' ? 'on' : '' %>">Privacidade</a></nav>
  </header>
  <article class="lgpd-doc">
    <p class="lgpd-ver">Versão <%= Termos.VERSAO %> · vigente desde <%= Termos.VIGENCIA %></p>
