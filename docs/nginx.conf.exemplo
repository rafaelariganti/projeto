# DRE System — exemplo de nginx na frente do Node (VPS)
# O Node roda com "npm start" (ou pm2/systemd) em 127.0.0.1:3000; o nginx cuida do HTTPS e repassa.
# No .env do sistema: TRUST_PROXY=1 (pra ele ler o IP real e o https do X-Forwarded-*).
server {
    listen 80;
    server_name dre.seudominio.com.br;

    client_max_body_size 22m;

    # O próprio Node já bloqueia src/, storage/, .env etc. — aqui é só uma segunda camada.
    location ~ /\.            { deny all; }
    location ~* \.(sql|md|lock|log)$ { deny all; }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
